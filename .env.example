# Frontend local -> backend local
VITE_API_URL=http://localhost:3000

# Backend local -> MinIO local (defaults do compose)
# Para usar o Tigris de produção, substitua estes valores pelas secrets do Fly.
FILE_STORAGE_DRIVER=minio
FILE_STORAGE_ENDPOINT_URL=http://minio:9000
FILE_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
BUCKET_NAME=refratia
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL_S3=http://minio:9000
AWS_PUBLIC_ENDPOINT_URL_S3=http://localhost:9000
CASE_DELETE_TOKEN=local-dev-delete-only

# PostgreSQL (same connection variables used by wallet-analysis)
# DATABASE_URL takes precedence when set.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=refratia
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_ADMIN_DB=postgres

# RefratIA's independent local Contabo tunnel.
# This host port differs from wallet-analysis (15432), so both can run.
REFRATIA_LOCAL_POSTGRES_TUNNEL_PORT=15433
CONTABO_POSTGRES_CONTAINER=bxui9zxeulehv0d9ekmpnhbo

# Optional "Claude Vision — Demo" extraction engine. Only anonymized PDFs released by
# frontend/scripts/anonymize_exams.py (report status APPROVED, i.e. "approved": true in overrides.json) are accepted.
ANTHROPIC_API_KEY=
# Replay a recorded Claude answer instead of calling the API (absolute path):
# CLAUDE_VISION_FIXTURE=/abs/path/frontend/data/_claude-vision/ademildo.fixture.json
# Model for Claude Vision (default claude-sonnet-5-5; claude-opus-5-5 remains available):
# CLAUDE_VISION_MODEL=claude-opus-5-5
# Where anonymize_exams.py writes its output (default ../frontend/data, relative to backend/):
# CLAUDE_VISION_APPROVED_DIR=../frontend/data
